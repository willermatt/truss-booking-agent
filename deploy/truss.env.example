# /etc/truss.env on the server (chmod 600, owned by the truss user). Never commit real values.
APP_DATABASE_URL=postgres://truss_app:CHANGE-ME@127.0.0.1:5432/truss
SPECTORA_API_KEY=CHANGE-ME
# From: npm run api -- new-token   (the token itself goes to ChatGPT, only its hash goes here)
TRUSS_API_TOKEN_SHA256=CHANGE-ME
# Leave this commented out until you approve the first live test booking.
# TRUSS_LIVE_SUBMISSIONS=enabled
